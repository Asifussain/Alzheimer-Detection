# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Configuration for Email Authentication
# IMPORTANT: Generate a strong, random secret key for production
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-characters

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Email Configuration (for password reset emails - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@ai4neuro.com

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key-change-in-production

# Application Settings
PORT=5000